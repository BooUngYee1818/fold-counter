        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fold Counter"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더블 카운터"
          }
        }
      }
    },
    "credit_prefix": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "made by"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제작"
          }
        }
      }
    },
    "credit_default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "made by YouTuber @CEO_BooungYee-TeCh"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유튜버 @CEO_BooungYee-TeCh 제작"
          }
