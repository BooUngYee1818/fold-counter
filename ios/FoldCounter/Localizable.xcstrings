    "settings_background_fold": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Treat app going to sleep as folded"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 잠들면 접힘으로 간주"
          }
        }
      }
    },
    "settings_background_fold_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: folding the phone (screen off) and unfolding it counts as one. With Guided Access on, the buttons cannot cause this by accident."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켬: 폰을 접어 화면이 꺼졌다가 다시 펼치면 1회로 셉니다. 사용법 유도가 켜져 있으면 버튼 실수로 세는 일은 없습니다."
          }
        }
      }
    },
    "settings_display": {
