    },
    "hub_searching": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching for the PC hub on this Wi-Fi…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 Wi-Fi 에서 PC 허브를 찾는 중…"
          }
        }
      }
    },
    "hub_connected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결됨: %@"
          }
        }
      }
    },
    "hub_error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hub connection lost, retrying…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허브 연결이 끊겨 다시 시도 중…"
          }
        }
      }
    },
    "setup_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts one every time the phone is folded and unfolded. The count is sent to the PC hub on the same Wi-Fi and shown as a caption in OBS / XSplit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰을 접었다 펼칠 때마다 1회 카운트합니다. 카운트는 같은 Wi-Fi 의 PC 허브로 전송되어 OBS / XSplit 자막으로 표시됩니다."
          }
        }
      }
    },
    "setup_name_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device name (shown in the caption)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 이름 (자막에 표시)"
          }
        }
      }
    },
    "setup_detector_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fold detection"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접힘 감지"
          }
        }
      }
    },
    "setup_detector_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS has no public hinge sensor API. The app treats switching to the small cover screen, or the app being put to sleep by folding, as \"closed\", and coming back to the big screen as \"open\". Use the test item in the menu to check the flow on any iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 에는 공개된 힌지 센서 API 가 없습니다. 작은 커버 화면으로 바뀌거나 접혀서 앱이 잠들면 \"접힘\", 큰 화면으로 돌아오면 \"펼침\"으로 판정합니다. 아무 아이폰에서나 메뉴의 테스트 항목으로 흐름을 확인할 수 있습니다."
          }
        }
      }
    },
    "setup_hub_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PC hub"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC 허브"
          }
        }
      }
    },
    "setup_manual_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect manually (if not found automatically)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 못 찾을 때 직접 연결"
          }
        }
      }
    },
    "setup_host_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hub IP, e.g. 192.168.0.10"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허브 IP, 예: 192.168.0.10"
          }
        }
      }
    },
    "setup_port_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트"
          }
        }
      }
    },
    "setup_manual_connect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to this address"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소로 연결"
          }
        }
      }
    },
    "setup_auto_connect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to automatic search"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 검색으로 되돌리기"
          }
        }
      }
    },
    "setup_privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy: no account, no analytics, no internet upload. Only device name, model and the count go to your own hub on the local network."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보: 계정 없음, 분석 없음, 인터넷 업로드 없음. 기기 이름, 모델명, 카운트만 같은 네트워크의 내 허브로 보냅니다."
          }
        }
      }
    },
    "setup_start": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start counting"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운팅 시작"
          }
        }
      }
    },
    "counter_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu: tap the screen 5 times quickly"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴: 화면을 빠르게 5번 탭"
