    "menu_reset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset count to 0"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운트 0 으로"
          }
        }
      }
    },
    "guided_banner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guided Access is off. Triple-click the side button → Start, so buttons are blocked while folding."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용법 유도가 꺼져 있습니다. 사이드 버튼 3번 클릭 → 시작을 누르면 접는 동안 버튼이 차단됩니다."
          }
        }
      }
    },
    "guided_first_time": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First time: Settings › Accessibility › Guided Access › On, then enable Accessibility Shortcut."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 한 번: 설정 › 손쉬운 사용 › 사용법 유도 › 켬, 그 다음 손쉬운 사용 단축키 켜기."
          }
        }
      }
    },
    "guided_on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guided Access on"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용법 유도 켜짐"
          }
        }
