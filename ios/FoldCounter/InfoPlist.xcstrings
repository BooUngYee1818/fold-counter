    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fold Counter"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더블 카운터"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds and talks to the Fold Counter hub on your Wi-Fi. Nothing leaves your network."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 Wi-Fi 의 폴더블 카운터 허브를 찾아 통신합니다. 네트워크 밖으로 나가는 정보는 없습니다."
          }
        }
      }
    }
  }
}